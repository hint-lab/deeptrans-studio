# DeepTrans Studio isolated local development only. Copy to .env.local.
# This must never contain a production database, Redis, COS, SMTP, or reused production secret.
NODE_ENV=development
IS_DEMO=yes
# Generate a local-only value with `npm run local:secret`, then paste it here. Do not reuse a production secret.
AUTH_SECRET=replace-with-a-local-random-secret
# The guarded local runner accepts only http loopback URLs on port 3000.
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# The local compose file owns this database and maps it only to 127.0.0.1.
LOCAL_POSTGRES_USER=deeptrans_local
LOCAL_POSTGRES_PASSWORD=deeptrans_local_password
LOCAL_POSTGRES_DB=deeptrans_local
DATABASE_URL=postgresql://deeptrans_local:deeptrans_local_password@127.0.0.1:55432/deeptrans_local?schema=public
DIRECT_URL=postgresql://deeptrans_local:deeptrans_local_password@127.0.0.1:55432/deeptrans_local?schema=public

# The local compose file owns this Valkey instance and binds it only to 127.0.0.1.
REDIS_URL=redis://127.0.0.1:56379

# Local object storage only; the bootstrap script disables COS and SMTP.
LOCAL_MINIO_USER=deeptrans_local
LOCAL_MINIO_PASSWORD=deeptrans_local_password
STORAGE_TYPE=minio
STORAGE_ENDPOINT=127.0.0.1
# MinIO Console is exposed separately at http://127.0.0.1:59003.
STORAGE_PORT=59002
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=deeptrans_local
STORAGE_SECRET_KEY=deeptrans_local_password
# local:setup creates and local:check verifies this owned bucket.
STORAGE_BUCKET=deeptrans-local

# Remote AI is opt-in. Keep this as no during ordinary UI/auth development.
# Translation-memory import, vector backfill, and other queued workflows also
# require a separate local Worker: npm run worker.
LOCAL_ALLOW_REMOTE_AI=no
# The local translation-memory schema uses a fixed 2048-dimensional vector contract.
EMBEDDING_DIMENSIONS=2048
MINERU_DISABLE=true
